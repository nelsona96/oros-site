# Public — safe to expose to the client. See docs/SPEC.md §6.
NEXT_PUBLIC_SANITY_PROJECT_ID=3hwrc45l
NEXT_PUBLIC_SANITY_DATASET=production

# Public — canonical site origin, no trailing slash. Used for metadataBase,
# sitemap.xml, robots.txt, and JSON-LD. Placeholder Vercel domain until
# Phase 15 assigns a real custom domain — swap then, nothing else changes.
NEXT_PUBLIC_SITE_URL=https://oros-productions.vercel.app

# Server-only — an editor-role Sanity API token, used by scripts/seed.ts.
# Generate one with: npx sanity tokens create "label" --role=editor
SANITY_API_TOKEN=

# Server-only — shared HMAC secret for the Sanity webhook that calls
# /api/revalidate on publish. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# The same value must be entered when creating the webhook at
# manage.sanity.io (see docs/SPEC.md §7). Not yet wired up — the Next app
# has no public URL until Phase 13's deploy.
SANITY_REVALIDATE_SECRET=

# Server-only — Resend API key used by /api/contact. Create one at
# resend.com/api-keys. Without it, the contact form 500s with "Contact form
# isn't configured yet."
RESEND_API_KEY=

# Server-only — inbox that receives contact-form submissions. Each email's
# reply-to is set to the submitter's address, so replying goes straight to
# them, not back through this address.
CONTACT_TO_EMAIL=
